# .env.example
# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=blogging_platform

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_PREFIX=/api/v1

# JWT Configuration (for future authentication)
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=30d
